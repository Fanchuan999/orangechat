<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_daddy_card_background"
  android:padding="14dp">

  <ImageView
    android:id="@+id/widget_background_image"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:alpha="0.22"
    android:contentDescription="@null"
    android:scaleType="centerCrop"
    android:visibility="gone" />

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_daddy_image_scrim"
    android:contentDescription="@null" />

  <TextView
    android:id="@+id/widget_seq"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="start|center_vertical"
    android:alpha="0.42"
    android:includeFontPadding="false"
    android:text="01"
    android:textColor="#66FF0000"
    android:textSize="66sp"
    android:textStyle="italic" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/widget_red_axis"
      android:layout_width="18dp"
      android:layout_height="match_parent"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="#FFFF0000"
        android:textSize="16sp"
        android:textStyle="bold" />

      <ImageView
        android:layout_width="2dp"
        android:layout_height="108dp"
        android:background="#FFFF0000"
        android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/widget_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:letterSpacing="0.38"
          android:maxLines="1"
          android:text="DADDY"
          android:textColor="#FFEDEDED"
          android:textSize="13sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/widget_sys_tag"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:includeFontPadding="false"
          android:text="/// SYS"
          android:textColor="#FFFF0000"
          android:textSize="11sp"
          android:textStyle="bold" />
      </LinearLayout>

      <TextView
        android:id="@+id/widget_mood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="心情轻快"
        android:textColor="#FFF2F2F2"
        android:textSize="30sp"
        android:textStyle="bold" />

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/widget_focus"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="牵挂你"
          android:textColor="#FFFF0000"
          android:textSize="15sp"
          android:textStyle="bold" />

        <ImageView
          android:layout_width="44dp"
          android:layout_height="1dp"
          android:layout_marginStart="12dp"
          android:background="#66FFFFFF"
          android:contentDescription="@null" />

        <TextView
          android:id="@+id/widget_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:includeFontPadding="false"
          android:text="00:00"
          android:textColor="#99FFFFFF"
          android:textSize="11sp" />
      </LinearLayout>

      <TextView
        android:id="@+id/widget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="今天也在你身边。"
        android:textColor="#E6FFFFFF"
        android:textSize="13sp" />

      <LinearLayout
        android:id="@+id/widget_large_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="08月13日"
            android:textColor="#99FFFFFF"
            android:textSize="11sp" />

          <TextView
            android:id="@+id/widget_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="步数待同步"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp" />
        </LinearLayout>

        <TextView
          android:id="@+id/widget_weather"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="天气待接入"
          android:textColor="#80FFFFFF"
          android:textSize="10sp" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widget_archive_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/widget_archive_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.24"
            android:text="ARCHIVE"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

          <ImageView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="#55FF0000"
            android:contentDescription="@null" />
        </LinearLayout>

        <TextView
          android:id="@+id/widget_recent_reply"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="2"
          android:text="最近回复"
          android:textColor="#D9FFFFFF"
          android:textSize="12sp"
          android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/widget_side_text"
    android:layout_width="22dp"
    android:layout_height="wrap_content"
    android:layout_gravity="end|center_vertical"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="想"
      android:textColor="#FFFF0000"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="你"
      android:textColor="#FFFF0000"
      android:textSize="13sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:text="中"
      android:textColor="#FFFF0000"
      android:textSize="13sp"
      android:textStyle="bold" />
  </LinearLayout>
</FrameLayout>
